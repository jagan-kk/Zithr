# MongoDB connection string
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=vinylcloud

# Comma-separated CORS allow-list (use * for all)
CORS_ORIGINS=*

# Optional bootstrap: used to seed the first API key on a brand-new database
# (ignored once at least one key exists). Set the same value as the frontend's VITE_API_KEY.
# INIT_API_KEY=vcs_live_xxxxxxxxxxxxxxxxxx

# Backblaze B2 (S3-compatible) object storage.
# All four are required for B2 to be active. When missing, uploads fall back to MongoDB GridFS.
BACKBLAZE_KEY_ID=
BACKBLAZE_API_KEY=
BACKBLAZE_BUCKET=
BACKBLAZE_ENDPOINT=