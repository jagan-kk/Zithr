# MongoDB connection string
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=vinylcloud

# Comma-separated CORS allow-list (use * for all)
CORS_ORIGINS=*

# Optional bootstrap: used to seed the first API key on a brand-new database
# (ignored once at least one key exists). Set the same value as the frontend's VITE_API_KEY.
# INIT_API_KEY=vcs_live_xxxxxxxxxxxxxxxxxx