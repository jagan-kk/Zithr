# Optional — leave unset to use the Vite dev proxy (vite.config.js routes /api -> :8000)
VITE_BACKEND_URL=http://localhost:8000

# Any valid API key from the backend (used for every request the web app makes).
# Grab yours from the app's "Streaming API Keys" panel and paste the vcs_live_... value.
VITE_API_KEY=vcs_live_your_key_here